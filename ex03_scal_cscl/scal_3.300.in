&CONTROL
   calculation   = 'scf'
   restart_mode  = 'from_scratch'
   tstress       = .true.
   tprnfor       = .true.
   outdir        = './tmp_3.300'
   prefix        = 'scal_3.300'
   pseudo_dir    = '/home/jdmin2003/qe-work/pseudo'
/
&SYSTEM
   ibrav         = 0
   nat           = 2
   ntyp          = 2
   ecutwfc       = 50.0
   ecutrho       = 400.0
   occupations   = 'smearing'
   smearing      = 'mv'
   degauss       = 0.02
/
&ELECTRONS
   conv_thr      = 1.0d-8
   mixing_beta   = 0.7
/
&IONS
/
&CELL
/

ATOMIC_SPECIES
   Sc  44.956  Sc.pbe-spn-kjpaw_psl.1.0.0.UPF
   Al  26.982  Al.pbe-n-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
   3.300000   0.000000   0.000000
   0.000000   3.300000   0.000000
   0.000000   0.000000   3.300000

ATOMIC_POSITIONS crystal
   Sc  0.0  0.0  0.0
   Al  0.5  0.5  0.5

K_POINTS automatic
   10 10 10  0 0 0
